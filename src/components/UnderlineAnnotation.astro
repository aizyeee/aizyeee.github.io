---
interface Props { delay?: number; }
const { delay = 0 } = Astro.props;
---
<span class="ink-underline" data-delay={delay}>
  <slot />
  <svg viewBox="0 0 210 24" preserveAspectRatio="none" aria-hidden="true">
    <!-- 一笔向右轻扫，在末端折回一小段；曲线的起伏保留手绘感。 -->
    <path d="M4,14 C37,10 72,17 112,13 S178,11 198,6 C204,4 205,6 200,10 Q194,14 184,15" />
  </svg>
</span>
<style>
  .ink-underline { position: relative; display: inline-block; white-space: nowrap; margin-inline: .04em; }
  .ink-underline svg {
    position: absolute; left: -.08em; bottom: -.22em;
    width: calc(100% + .16em); height: .5em;
    overflow: visible; pointer-events: none;
  }
  .ink-underline path {
    fill: none; stroke: var(--ink); stroke-width: 2.4;
    stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke;
    /* 脚本初始化前隐藏笔画，实际长度由 getTotalLength() 设置。 */
    stroke-dasharray: 600; stroke-dashoffset: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .ink-underline path { stroke-dasharray: none !important; stroke-dashoffset: 0 !important; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.ink-underline').forEach((el) => {
    const path = el.querySelector('path') as SVGPathElement;
    const length = Math.ceil(path.getTotalLength()) + 4;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    path.style.strokeDasharray = String(length);
    path.style.strokeDashoffset = String(length);

    const draw = (delay: number) => {
      if (motion.matches) return;
      path.getAnimations().forEach((animation) => animation.cancel());
      path.animate([{ strokeDashoffset: length }, { strokeDashoffset: 0 }], {
        duration: 950, delay, fill: 'forwards',
        easing: 'cubic-bezier(.55,.06,.35,.98)',
      });
    };

    draw(Number(el.dataset.delay ?? 0));
    el.addEventListener('mouseenter', () => draw(0));
  });
</script>
